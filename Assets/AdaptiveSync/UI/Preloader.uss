.boot {
    justify-content: space-between;
}

.boot__center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.boot__logo {
    width: 88px;
    height: 88px;
    border-radius: 26px;
    background-color: var(--accent);
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.boot__logo-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--on-accent);
    padding: 0;
    margin: 0;
}

.boot__title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text);
    padding: 0;
    margin: 0;
}

.boot__subtitle {
    font-size: 14px;
    color: var(--muted);
    padding: 0;
    margin: 6px 0 0 0;
}

.boot__bottom {
    padding: 0 32px 48px 32px;
}

.boot__step {
    font-size: 14px;
    color: var(--text);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 12px 0;
}

.progress {
    height: 6px;
    border-radius: 3px;
    background-color: var(--surface-2);
    overflow: hidden;
}

.progress__fill {
    height: 100%;
    width: 0;
    border-radius: 3px;
    background-color: var(--accent);
    transition-property: width;
    transition-duration: 0.2s;
}

.boot__percent {
    font-size: 12px;
    color: var(--muted);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 8px 0 0 0;
}

.boot__error {
    display: none;
    margin-top: 20px;
    padding: 16px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(248, 113, 113, 0.5);
    background-color: rgba(248, 113, 113, 0.08);
}

.boot__error--visible {
    display: flex;
}

.boot__error-text {
    font-size: 13px;
    color: var(--danger);
    white-space: normal;
    padding: 0;
    margin: 0 0 8px 0;
}
